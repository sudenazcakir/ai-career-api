# Example environment file for local development
# Copy this file to `.env` and update the values for your machine.
# Do not commit your real `.env` file.

# App port
PORT=5001

# Default local MongoDB connection
MONGO_URI=mongodb://127.0.0.1:27017/ai-career-api

# If you want to use MongoDB Atlas instead, replace the MONGO_URI above with:
# mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ai-career-api?retryWrites=true&w=majority

# Adzuna API credentials
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
