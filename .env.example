# Example environment file for local development
# Copy this file to `.env` and update the values for your machine.
# Do not commit your real `.env` file.

# App port
PORT=5001

# JWT secret for local auth. Replace in real environments.
JWT_SECRET=replace_this_local_dev_secret

# Optional frontend override for Swagger/backend links
VITE_BACKEND_ORIGIN=http://localhost:5001

# Allowed CORS origins (comma-separated). Leave unset for local dev defaults.
# In production set this to your Vercel URL: https://ai-career-api-eight.vercel.app
# CORS_ORIGIN=https://ai-career-api-eight.vercel.app

# Default local MongoDB connection
MONGO_URI=mongodb://127.0.0.1:27017/ai-career-api

# If you want to use MongoDB Atlas instead, replace the MONGO_URI above with:
# mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ai-career-api?retryWrites=true&w=majority

# Adzuna API credentials
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Optional OpenAI credentials for AI-assisted Career Fit Matrix
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
