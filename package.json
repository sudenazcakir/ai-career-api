{
  "name": "ai-career-api",
  "version": "1.0.0",
  "description": "",
  "main": "backend/server.js",
  "scripts": {
    "server": "node backend/server.js",
    "client": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:prod": "vite build && mkdir -p backend/public && cp -r frontend/dist/. backend/public/",
    "dev": "vite",
    "start": "node backend/server.js",
    "seed:demo": "node backend/scripts/seedDemo.js",
    "seed:test": "node backend/scripts/seedFullTestData.js",
    "seed:test:reset": "node backend/scripts/seedFullTestData.js --reset",
    "check:db": "node backend/scripts/checkDb.js",
    "test:applications": "node backend/scripts/testApplications.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:backend": "node --test backend/__tests__/routes/cvUpload.test.js",
    "test:integration": "node --test backend/__tests__/routes/cvRoutes.integration.test.js && node --test backend/__tests__/routes/applicationRoutes.integration.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "axios": "^1.15.2",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.6.1",
    "multer": "^2.1.1",
    "pdf-parse": "^1.1.1",
    "postcss": "^8.5.14",
    "react": "^19.2.5",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.14.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.5"
  }
}
